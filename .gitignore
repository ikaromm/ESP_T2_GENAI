# dados (FINDSum tem ~6.5 GB; baixe com scripts/fetch_findsum.py)
# `data/*` em vez de `data/` porque o git nao desce num diretorio ignorado:
# sem isso as excecoes abaixo nao teriam efeito.
data/*

# EXCECAO: os manifestos de particao SAO versionados de proposito. Eles congelam
# quais documentos vao para exemplos, dev e avaliacao. Sem estar no git a
# particao nao e reproduzivel e a avaliacao final perde a garantia de que o
# conjunto foi definido antes de olhar resultados. Sao ~450 KB de texto.
!data/interim/
data/interim/*
!data/interim/splits-*.json

# artefatos de experimento
# `outputs/` e o completo, com predictions.jsonl: cresce com o numero de
# documentos (~100 MB em 1.000) e fica fora do git.
outputs/
runs/
# `dist/` sao os tarballs para download via scp.
dist/
# ATENCAO: `results/` NAO entra aqui de proposito. E a versao leve (~50 KB por
# rodada: metricas agregadas, scores por documento e tabela estatistica) e o
# lugar onde os resultados do trabalho ficam versionados. Ver deploy.sh.
*.faiss
*.index
models/
.cache/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# jupyter
.ipynb_checkpoints/

# ambiente / segredos
.env
.env.*
!.env.example

# editores e SO
.vscode/
.idea/
.DS_Store
*.swp
